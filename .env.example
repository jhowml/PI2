# Servidor
PORT=3000
NODE_ENV=development

# CORS — origens separadas por vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Banco de dados (PostgreSQL)
# Opção 1: connection string completa (tem prioridade sobre as variáveis DB_*)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soberania_digital
# Opção 2: variáveis individuais (usadas apenas se DATABASE_URL não estiver definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=soberania_digital

# Autenticação — JWT_SECRET precisa ter no mínimo 10 caracteres
JWT_SECRET=troque_por_um_segredo_forte
JWT_EXPIRES_IN=7d

# Usuário único de acesso à aplicação
APP_USERNAME=admin
APP_PASSWORD=troque_esta_senha
