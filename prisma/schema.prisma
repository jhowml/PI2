generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(100)
  telefone    String   @db.VarChar(11)
  obs         String?  @db.VarChar(255)
  cep         String?  @db.Char(8)
  logradouro  String?  @db.VarChar(150)
  numero      String?  @db.VarChar(10)
  complemento String?  @db.VarChar(60)
  bairro      String?  @db.VarChar(80)
  cidade      String?  @db.VarChar(80)
  uf          String?  @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at")
  pedidos     Pedido[]

  @@map("clientes")
}

model Cardapio {
  id          Int          @id @default(autoincrement())
  nome        String       @db.VarChar(100)
  descricao   String?      @db.VarChar(255)
  preco       Decimal      @db.Decimal(10, 2)
  categoria   String       @db.VarChar(50)
  disponivel  Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  deletedAt   DateTime?    @map("deleted_at")
  itensPedido ItemPedido[]

  @@map("cardapio")
}

model Pedido {
  id          Int          @id @default(autoincrement())
  dataPedido  DateTime     @default(now()) @map("data_pedido")
  status      StatusPedido @default(PENDENTE)
  tipoEntrega TipoEntrega  @map("tipo_entrega")
  taxaEntrega Decimal      @default(0) @map("taxa_entrega") @db.Decimal(10, 2)
  desconto    Decimal      @default(0) @db.Decimal(10, 2)
  valorTotal  Decimal      @map("valor_total") @db.Decimal(10, 2)
  obs         String?      @db.VarChar(255)
  clienteId   Int          @map("cliente_id")
  cliente     Cliente      @relation(fields: [clienteId], references: [id])
  itens       ItemPedido[]
  pagamento   Pagamento?

  @@index([clienteId])
  @@index([status])
  @@map("pedidos")
}

model ItemPedido {
  id            Int      @id @default(autoincrement())
  quantidade    Int
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  pedidoId      Int      @map("pedido_id")
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  cardapioId    Int      @map("cardapio_id")
  cardapio      Cardapio @relation(fields: [cardapioId], references: [id])

  @@index([pedidoId])
  @@index([cardapioId])
  @@map("itens_pedido")
}

model Pagamento {
  id            Int             @id @default(autoincrement())
  forma         FormaPagamento
  status        StatusPagamento @default(PENDENTE)
  valor         Decimal         @db.Decimal(10, 2)
  dataPagamento DateTime?       @map("data_pagamento")
  pedidoId      Int             @unique @map("pedido_id")
  pedido        Pedido          @relation(fields: [pedidoId], references: [id])

  @@map("pagamentos")
}

enum StatusPedido {
  PENDENTE
  CONFIRMADO
  PREPARANDO
  ENTREGUE
  CANCELADO
}

enum TipoEntrega {
  ENTREGA
  RETIRADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ESTORNADO
}
